# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# WeChat mini-program credentials
# Leave both empty for local development: when NODE_ENV != production and these
# are unset, login bypasses code2Session and signs in a shared local dev user.
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# JWT signing secret (use a strong random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_strong_random_secret

# AI service keys
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=your_siliconflow_api_key

# CORS: comma-separated list of allowed origins (default: http://localhost:*)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
